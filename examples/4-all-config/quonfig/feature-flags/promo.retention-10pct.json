{
  "key": "promo.retention-10pct",
  "type": "feature_flag",
  "valueType": "bool",
  "description": "Retention offer for paying customers Jev scored as frustrated.",
  "default": {
    "rules": [
      {
        "criteria": [
          {
            "propertyName": "jev.frustration",
            "operator": "PROP_GREATER_THAN_OR_EQUAL",
            "valueToMatch": { "type": "double", "value": 1.5 }
          },
          {
            "propertyName": "user.plan",
            "operator": "PROP_IS_NOT_ONE_OF",
            "valueToMatch": { "type": "string_list", "value": ["free"] }
          }
        ],
        "value": { "type": "bool", "value": true }
      },
      { "criteria": [{ "operator": "ALWAYS_TRUE" }], "value": { "type": "bool", "value": false } }
    ]
  },
  "environments": [],
  "variants": []
}
